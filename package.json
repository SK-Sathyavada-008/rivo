{
  "name": "rivo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Rivo - Mobile-first fee reconciliation platform for dance academies and schools",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",

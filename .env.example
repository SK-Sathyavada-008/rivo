# ==============================================================
# RIVO ENVIRONMENT CONFIGURATION (.env.example)
# Do not commit real secrets or production credentials to git.
# ==============================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# In production, use standard or direct replica set connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rivo?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Gemma AI Inference Adapter (Optional)
# If left empty, Rivo automatically uses the deterministic rule-based extractor
GEMMA_API_URL=https://api.together.xyz/v1/chat/completions
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=google/gemma-2-9b-it

# Sentry Error Tracking & Performance Telemetry (Optional)
SENTRY_DSN=
